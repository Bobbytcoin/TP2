#include <iostream>
using namespace std;

int main() {
    int N;
    int L;
    cout << "Saisir la longueur du rectangle" << endl;
    cin >> N;
    cout << "Saisir la largeur du rectangle" << endl;
    cin >> L;
    
    cout << string(N, '*') << endl; 
    for (int i = 1; i <= L-2; i++) { 
        cout << '*' << string(N-2, ' ') << '*' << endl;
    
    
    }
    cout << string(N, '*') << endl;
    
    
}
    
