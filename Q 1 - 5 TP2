#include <iostream>
using namespace std;

int main() {
    int N;
    cout << "Saisir la hauteur du triangle" << endl;
    cin >> N;
    for (int i = 1; i <= N; i+=2) {
        cout << string(i, '*') << endl;
        
    }
    for (int j = N-2; j > 0; j-=2) {
        cout << string(j, '*') << endl;
        
    }
}


