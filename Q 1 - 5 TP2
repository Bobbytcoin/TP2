#include <iostream>
using namespace std;

int main() {
    int N;
    cout << "Saisir la hauteur du triangle" << endl;
    cin >> N;
    for (int i = 1; i <= N; i++) {
        cout << string(i, '*') << endl;
        
    }
    for (int j = N-1; j > 0; j--) {
        cout << string(j, '*') << endl;
        
    }
}


