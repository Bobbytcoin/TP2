#include <iostream>
using namespace std;

int main() {
    int N;
    int M;
    
    cout << "Taille du damier (N) ?" << endl;
    cin >> N;
    cout << "Longueur des lignes (M) ?" << endl;
    cin >> M;
    
    for (int j = 1; j <= N; j++) { 
        if (j % 2 == 0) {
            cout << " ";
        }
        
        for (int i = 1; i <= M / 2; i++) {
            cout << "* ";
        }
        cout << endl; 
    }
    

}
